{
  "name": "@tron/claude-config",
  "version": "1.15.1",
  "description": "Claude Code enforcement harness for tron repos",
  "private": true,
  "scripts": {
    "postinstall": "node scripts/postinstall.js",
    "ensure:tron-graph": "node scripts/lib/ensure-tron-graph.js",
    "sync:quanthub": "bash scripts/sync-quanthub-fork.sh",
    "upstream:watch": "node upstream/watch.js",
    "upstream:originality": "node upstream/originality.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "managed/",
    "scripts/postinstall.js",
    "scripts/sync-tron-rules.js",
    "scripts/lib/*.js",
    "!scripts/lib/*.test.js",
    "README.md",
    "HARNESS-GUIDE.md",
    "docs/assets/"
  ]
}
