#!/bin/sh
set -eu

dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
: "${IMPECCABLE_SKILL_DIR:=$(CDPATH= cd -- "$dir/.." && pwd)}"
: "${IMPECCABLE_SELF:=$0}"
export IMPECCABLE_SKILL_DIR IMPECCABLE_SELF

refuse() {
  echo "impeccable: engine integrity: $*; reinstall exonous or set IMPECCABLE_BIN to an explicitly trusted engine." >&2
  exit 127
}
if [ "${IMPECCABLE_BIN+x}" = x ]; then
  [ -f "$IMPECCABLE_BIN" ] && [ -x "$IMPECCABLE_BIN" ] || refuse 'invalid IMPECCABLE_BIN override'
  exec "$IMPECCABLE_BIN" "$@"
fi
version=$(awk '
  { sub(/\r$/, ""); if (NR != 1 || $0 != "0.1.5") bad = 1 }
  END { if (NR != 1 || bad) exit 1; print "0.1.5" }
' "$dir/VERSION" 2>/dev/null) || refuse 'VERSION missing or invalid'
[ "$version" = 0.1.5 ] || refuse 'VERSION mismatch'
manifest="$dir/ENGINE-CHECKSUMS"
[ -f "$manifest" ] || refuse 'manifest missing'
awk '
  { sub(/\r$/, "") }
  NR == 1 { if ($0 != "version 0.1.5") exit 1; next }
  { if (NF != 2 || length($1) != 64 || $1 ~ /[^a-f0-9]/ || $0 != $1 "  " $2 || seen[$2]++) exit 1
    if ($2 !~ /^impeccable-(darwin|linux)-(arm64|x64)$/ && $2 != "impeccable-windows-x64.exe") exit 1 }
  END { if (NR < 2) exit 1 }
' "$manifest" || refuse 'invalid manifest'
case "$(uname -s)" in
  Darwin) os=darwin;; Linux) os=linux;; MINGW*|MSYS*|CYGWIN*|Windows_NT) os=windows;; *) refuse 'unsupported platform';;
esac
case "$(uname -m)" in
  arm64|aarch64) arch=arm64;; x86_64|amd64) arch=x64;; *) refuse 'unsupported architecture';;
esac
exe=
if [ "$os" = windows ]; then arch=x64; exe=.exe; fi
asset="impeccable-$os-$arch$exe"
expected=$(awk -v asset="$asset" '{sub(/\r$/, ""); if ($2 == asset) print $1}' "$manifest")
[ -n "$expected" ] || refuse "manifest missing hash for $asset"
if command -v sha256sum >/dev/null 2>&1; then
  hash_tool=sha256sum
elif command -v shasum >/dev/null 2>&1; then
  hash_tool=shasum
else
  refuse 'SHA256 tool unavailable'
fi
verify() {
  [ -f "$1" ] || refuse "not a regular file: $1"
  if [ "$hash_tool" = shasum ]; then
    digest=$(shasum -a 256 "$1") || refuse 'SHA256 failed'
  else
    digest=$(sha256sum "$1") || refuse 'SHA256 failed'
  fi
  actual=${digest%% *}
  [ "$actual" = "$expected" ] || refuse "checksum mismatch: $1"
}
run_verified() {
  verify "$1"
  candidate=$1
  shift
  if [ ! -x "$candidate" ]; then
    chmod +x "$candidate" 2>/dev/null || refuse "cannot make engine executable: $candidate"
  fi
  exec "$candidate" "$@"
}
cache_root="${IMPECCABLE_HOME:-${HOME:-/nonexistent}/.impeccable}"
cached="$cache_root/bin/$version/impeccable$exe"
sibling="$dir/bin/$os-$arch/impeccable$exe"
home_bin="${HOME:-/nonexistent}/.impeccable/bin/impeccable$exe"
for candidate in "$sibling" "$home_bin" "$cached"; do
  if [ -e "$candidate" ]; then run_verified "$candidate" "$@"; fi
done
candidate=$(command -v "impeccable$exe" || true)
if [ -n "$candidate" ]; then run_verified "$candidate" "$@"; fi
[ -z "${IMPECCABLE_LAUNCHER_PROBE:-}" ] || refuse 'no authenticated engine installed'
mkdir -p "$cache_root/bin/$version" 2>/dev/null || refuse "cannot create cache: $cache_root"
staging=$(umask 077; mktemp -d "$cache_root/bin/$version/.impeccable.XXXXXXXX") || refuse 'cannot create private staging directory'
trap 'rm -f "$staging/engine"; rmdir "$staging" 2>/dev/null || true' EXIT
trap 'exit 127' HUP INT TERM
tmp="$staging/engine"
url="${IMPECCABLE_DOWNLOAD_BASE:-https://github.com/pbakaus/impeccable/releases/download}/engine-v$version/$asset"
if command -v curl >/dev/null 2>&1; then
  curl -fsSL --retry 2 -o "$tmp" "$url" || refuse "could not download $url; check network access and cache permissions"
elif command -v wget >/dev/null 2>&1; then
  wget -q -O "$tmp" "$url" || refuse "could not download $url; check network access and cache permissions"
else
  refuse 'curl or wget unavailable'
fi
verify "$tmp"
chmod +x "$tmp" || refuse 'cannot make verified download executable'
mv -f "$tmp" "$cached" || refuse 'cannot publish verified download'
rmdir "$staging" || refuse 'cannot remove staging directory'
trap - EXIT HUP INT TERM
run_verified "$cached" "$@"
